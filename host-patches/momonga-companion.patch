diff --git a/app/electron/main/test/momonga-proactive.test.ts b/app/electron/main/test/momonga-proactive.test.ts
new file mode 100644
--- /dev/null
+++ b/app/electron/main/test/momonga-proactive.test.ts
@@ -0,0 +1,77 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { JsonlChatSessionStore } from "@dap/storage";
+import { createChatPipeline } from "../src/chat-pipeline.js";
+import { createProactiveSpeech, momongaProactiveHint, type ProactiveSpeechOptions } from "../src/proactive-speech.js";
+
+const NOON = Date.parse("2026-10-18T12:00:00") / 1000;
+const dirs: string[] = [];
+afterEach(() => { for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true }); });
+
+function speech(over: Partial<ProactiveSpeechOptions> = {}) {
+  const calls: string[] = [], bubbles: string[] = [];
+  const service = createProactiveSpeech({
+    runTurn: async (hint) => { calls.push(hint); return "귀여운 나를 칭찬해 봐!"; },
+    isBusy: () => false, petVisible: () => true, idleSeconds: () => 100 * 60,
+    currentStateKind: () => null, sessionId: "test", onBubble: text => bubbles.push(text),
+    memory: { recent: () => [] }, lastInteractionAt: () => null,
+    now: () => NOON, rng: () => 0, characterId: () => "momonga", ...over,
+  });
+  return { service, calls, bubbles };
+}
+
+describe("Momonga spontaneous chat", () => {
+  it("offers praise, self-praise and a question only for Momonga", () => {
+    expect(momongaProactiveHint("momonga", () => 0)).toContain("칭찬");
+    expect(momongaProactiveHint("momonga", () => 0.4)).toContain("자랑");
+    expect(momongaProactiveHint("momonga", () => 0.9)).toContain("질문");
+    for (const id of [null, "chiikawa", "hachiware", "usagi", "rakko", "shisa", "kurimanju", "siren", "furuhonya", "anoko", "dekatsuyo"]) {
+      expect(momongaProactiveHint(id)).toBeNull();
+      const { service, calls } = speech({ characterId: () => id }); service.tick(); expect(calls).toHaveLength(0);
+    }
+  });
+
+  it("keeps busy, hidden, recent-input, muted-state and off gates", () => {
+    for (const over of [
+      { isBusy: () => true }, { petVisible: () => false }, { idleSeconds: () => 60 },
+      { currentStateKind: () => "thinking" }, { prefs: () => ({ proactive_quiet_profile: "off" }) },
+    ]) {
+      const { service, calls } = speech(over); service.tick(); expect(calls).toHaveLength(0);
+    }
+  });
+
+  it("honors cooldown and stops supplying the topic when the character changes", async () => {
+    let id = "momonga";
+    const { service, calls, bubbles } = speech({ characterId: () => id });
+    service.tick(); await vi.waitFor(() => expect(bubbles).toHaveLength(1));
+    service.tick(NOON + 60); expect(calls).toHaveLength(1);
+    id = "hachiware"; service.tick(NOON + 3 * 3600); expect(calls).toHaveLength(1);
+  });
+
+  it("one generated reply reaches bubble, live chat and persisted history with one stable id", async () => {
+    const dir = mkdtempSync(join(tmpdir(), "dap-momonga-")); dirs.push(dir);
+    const pushes: Array<{ type: string; payload: Record<string, unknown> }> = [];
+    let id = "momonga";
+    const reply = "귀여운 나를 칭찬해 봐! 오늘도 귀엽지?";
+    const llm = { generate: async () => "", summarizeText: async () => "", classifyIntent: async () => "chat_local", chatReply: vi.fn(async (_user: string, _history?: string[] | null) => reply) };
+    const chat = createChatPipeline({ userDataDir: dir, broadcast: (type, payload) => pushes.push({ type, payload }), llm,
+      characterPersona: () => ({ id, displayName: "모몽가", traits: [], speakingStyle: "귀여움을 자랑하는 모몽가", contextHint: "짧게 말해" }), logAppend: () => {}, });
+    const { service, bubbles } = speech({ sessionId: chat.sessionId, runTurn: hint => chat.runProactiveTurn(hint, { publishToChat: true, characterId: "momonga" }) });
+    service.tick(); await vi.waitFor(() => expect(bubbles).toEqual([reply]));
+    const rows = new JsonlChatSessionStore(join(dir, "chat_sessions")).getMessages(chat.sessionId);
+    expect(rows).toHaveLength(1); expect(rows[0]).toMatchObject({ role: "assistant", text: reply, metadata: { proactive: true } });
+    const live = pushes.filter(p => p.type === "message.appended");
+    expect(live).toHaveLength(1); expect(live[0]!.payload["message"]).toMatchObject({ message_id: rows[0]!.id, speaker: "모몽가", text: reply });
+    expect(llm.chatReply).toHaveBeenCalledTimes(1);
+    pushes.length = 0; chat.replayOnReady();
+    expect(pushes.filter(p => p.type === "message.appended")[0]!.payload["message"]).toMatchObject({ message_id: rows[0]!.id });
+    chat.handler({ utterance: "귀엽네, 칭찬해줄게." }); await chat.whenIdle();
+    expect(llm.chatReply.mock.calls[1]?.[1]?.some(line => line.includes(reply))).toBe(true);
+    expect(new JsonlChatSessionStore(join(dir, "chat_sessions")).getMessages(chat.sessionId)).toHaveLength(3);
+    id = "hachiware";
+    expect(await chat.runProactiveTurn("이전 모몽가 요청", { publishToChat: true, characterId: "momonga" })).toBeNull();
+    expect(llm.chatReply).toHaveBeenCalledTimes(2);
+  });
+});
