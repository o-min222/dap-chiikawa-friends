+
+export function momongaProactiveHint(characterId: string | null, rng: () => number = Math.random): string | null {
+  if (characterId !== "momonga") return null;
+  const topics = [
+    "귀여운 나를 칭찬해 보라고 능청스럽게 요구해.",
+    "오늘도 내가 귀엽다고 짧게 자랑해.",
+    "사용자에게 가벼운 질문을 하며 먼저 말을 걸어.",
+  ];
+  const topic = topics[Math.min(topics.length - 1, Math.max(0, Math.floor(rng() * topics.length)))]!;
+  return `[모몽가 먼저 말걸기] ${topic} 기존 말투로 1~2문장만 말해. 보지 못한 사용자 행동을 꾸미거나 답을 재촉하지 마.`;
