+import { describe, expect, it, vi } from "vitest";
+import type { AppConfigState, DapBridge, PetAppearance } from "@dap/electron-main";
+import { mountConfigSection } from "../src/settings-config-view.js";
+
+describe("plugin skin in appearance settings", () => {
+  it("shows the applied name, preserves it when resizing and follows live skin changes", async () => {
+    let saved: AppConfigState = { config: { petCharacter: "mini", petMiniProfileId: "saved-mini", petSize: 160 }, autostart: false, effectiveTheme: "light" };
+    const skin = { id: "friends.momonga", imageDataUrl: "data:image/png;base64,AA==", definition: { id: "momonga", displayName: "모몽가", schemaVersion: 1 as const, spritesheetPath: "assets/sheet.png", cell: { width: 192, height: 208 }, grid: { columns: 8, rows: 1 }, animations: { idle: { row: 0, holdsMs: [100] } } } };
+    let appearance: PetAppearance = { character: "cat", size: 160, skin };
+    let listener: ((next: PetAppearance) => void) | undefined;
+    const unsubscribe = vi.fn();
+    const saveConfig = vi.fn(async (patch: { config: AppConfigState["config"] }) => {
+      saved = { ...saved, config: { ...saved.config, ...patch.config } };
+      appearance = { ...appearance, size: saved.config.petSize ?? 130 };
+      if ("petCharacter" in patch.config) appearance = { character: "cat", size: appearance.size };
+      return saved;
+    });
+    const bridge = {
+      getConfig: async () => saved, saveConfig,
+      getPetAppearance: async () => appearance, getPetProfiles: async () => [],
+      getAppUpdateStatus: async () => ({ phase: "unsupported", currentVersion: "test" }),
+      onPetAppearanceChanged: (cb: (next: PetAppearance) => void) => { listener = cb; return unsubscribe; },
+    } as unknown as DapBridge;
+    const root = document.createElement("div");
+    const view = mountConfigSection(root, bridge, "general");
+    const selected = () => root.querySelector<HTMLButtonElement>('[aria-label="현재 스킨: 모몽가"]');
+    await vi.waitFor(() => expect(selected()?.getAttribute("aria-pressed")).toBe("true"));
+    expect(root.textContent).toContain("모몽가 · 160px");
+    const slider = root.querySelector<HTMLInputElement>('input[type="range"]')!;
+    slider.value = "200"; slider.dispatchEvent(new Event("change"));
+    await vi.waitFor(() => expect(root.textContent).toContain("모몽가 · 200px"));
+    expect(saveConfig).toHaveBeenCalledWith({ config: { petSize: 200 } });
+    expect(appearance.skin?.id).toBe(skin.id);
+    appearance = { ...appearance, skin: { ...skin, id: "friends.usagi", definition: { ...skin.definition, id: "usagi", displayName: "우사기" } } };
+    listener!(appearance);
+    expect(root.textContent).toContain("우사기 · 200px");
+    const cat = [...root.querySelectorAll("button")].find(button => button.textContent === "기본 고양이")!;
+    expect(cat.getAttribute("aria-pressed")).toBe("false");
+    cat.click();
+    await vi.waitFor(() => expect(root.textContent).toContain("기본 고양이 · 200px"));
+    expect(saveConfig).toHaveBeenCalledWith({ config: { petCharacter: "cat" } });
+    view.destroy();
+    expect(unsubscribe).toHaveBeenCalledOnce();
+  });
+});
