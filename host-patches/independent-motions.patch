+export function skinHopOffset(clip: PetSkinDefinition["animations"][string], elapsed: number): number {
+  const time = Math.max(0, elapsed) % clip.holdsMs.reduce((sum, hold) => sum + hold, 0);
+  for (const hop of clip.hops ?? []) {
+    const phase = (time - hop.startMs) / hop.durationMs;
+    if (phase > 0 && phase < 1) return -4 * hop.heightPx * phase * (1 - phase);
+  }
+  return 0;
+}
