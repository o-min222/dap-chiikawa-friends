{
  "name": "dap-chiikawa-friends",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=assets/catalog.json --watch-path=assets/originals.json scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run build && npm test && npm run check",
    "pack": "python3 scripts/package.py"
  }
}
