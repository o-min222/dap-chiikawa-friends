     expect(root.querySelector(".dap-pet__bubble")).toBeNull();
   });
 
+  it("separates speech from agent badges while preserving keyed nodes across updates", () => {
+    const { bridge, emit } = fakeBridge();
+    const model = new PetModel(bridge);
+    const view = mountPetView(root, model, bridge);
+    emit("overlay.bubble.show", { id: "speech", text: "야하!", style: "react", duration_ms: 3000 });
+    emit("overlay.bubble.show", { id: "codex", text: "", style: "work", duration_ms: 0, image: "cli_codex" });
+    emit("overlay.bubble.show", { id: "claude", text: "", style: "work", duration_ms: 0, image: "cli_claude" });
+    const speech = root.querySelector(".dap-pet__bubbles:not(.dap-pet__bubbles--work)")!;
+    const work = root.querySelector(".dap-pet__bubbles--work")!;
+    expect(speech.textContent).toBe("야하!");
+    expect(speech.querySelectorAll("img")).toHaveLength(0);
+    expect(work.querySelectorAll("img")).toHaveLength(2);
+    const codex = work.querySelector('[data-id="codex"]')!;
+    const image = codex.querySelector("img");
+    emit("pet.position_set", { position: { x: 300, y: 300 } });
+    expect(work.querySelector('[data-id="codex"]')).toBe(codex);
+    expect(codex.querySelector("img")).toBe(image);
+    emit("overlay.bubble.show", { id: "codex", text: "완료", style: "speech", duration_ms: 3000 });
+    expect(speech.querySelector('[data-id="codex"]')).toBe(codex);
+    expect(work.querySelectorAll("img")).toHaveLength(1);
+    emit("overlay.bubble.dismiss", { id: "claude" });
+    expect(work.children).toHaveLength(0);
+    view.destroy(); model.dispose();
+  });
+
+  it.each(["middle", "top-left", "bottom-right"])("keeps both bubble layers visible and separate at %s", (position) => {
+    const { bridge, emit } = fakeBridge();
+    const model = new PetModel(bridge);
+    const view = mountPetView(root, model, bridge);
+    const x = position === "top-left" ? 0 : position === "bottom-right" ? window.innerWidth - 130 : 250;
+    const y = position === "top-left" ? 0 : position === "bottom-right" ? window.innerHeight - 130 : 250;
+    const anchor = root.querySelector<HTMLElement>(".pet-anchor")!;
+    const speech = root.querySelector<HTMLElement>(".dap-pet__bubbles:not(.dap-pet__bubbles--work)")!;
+    const work = root.querySelector<HTMLElement>(".dap-pet__bubbles--work")!;
+    vi.spyOn(anchor, "getBoundingClientRect").mockReturnValue(new DOMRect(x, y, 130, 130));
+    vi.spyOn(speech, "getBoundingClientRect").mockReturnValue(new DOMRect(0, 0, 180, 50));
+    vi.spyOn(work, "getBoundingClientRect").mockReturnValue(new DOMRect(0, 0, 220, 30));
+    emit("overlay.bubble.show", { id: "speech", text: "우럇!", style: "react", duration_ms: 3000 });
+    emit("overlay.bubble.show", { id: "agent", text: "", style: "work", duration_ms: 0, image: "cli_codex" });
+    const speechTop = y + parseFloat(speech.style.top);
+    const workTop = y + parseFloat(work.style.top);
+    expect(speechTop).toBeGreaterThanOrEqual(8);
+    expect(workTop + 30).toBeLessThanOrEqual(window.innerHeight - 8);
+    expect(speechTop + 50 + 8).toBeLessThanOrEqual(workTop);
+    for (const [box, width] of [[speech, 180], [work, 220]] as const) {
+      const left = x + parseFloat(box.style.left);
+      expect(left).toBeGreaterThanOrEqual(8);
+      expect(left + width).toBeLessThanOrEqual(window.innerWidth - 8);
+    }
+    if (position === "middle") {
+      expect(speechTop + 50).toBeLessThan(y);
+      expect(workTop).toBeGreaterThan(y + 130);
+    } else if (position === "top-left") {
+      expect(x + parseFloat(speech.style.left)).toBeGreaterThanOrEqual(x + 130 + 8);
+    } else {
+      expect(x + parseFloat(work.style.left) + 220).toBeLessThanOrEqual(x - 8);
+    }
+    window.dispatchEvent(new Event("resize"));
+    expect(y + parseFloat(work.style.top)).toBe(workTop);
+    view.destroy(); model.dispose();
+  });
+
